# === Neon (Postgres serverless) ===
DATABASE_URL=
DIRECT_URL=
# CHECKPOINT 1: cole aqui as 2 URLs do Neon (pooled + direct). Me avise quando preencher.

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
# CHECKPOINT 2: depois do primeiro deploy Vercel, trocar para https://xxx.vercel.app

# === Firebase Client (web) ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# CHECKPOINT 3: pegar em Firebase Console > Project Settings > Web App

# === Firebase Admin (backend) ===
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# CHECKPOINT 4: Service Account JSON > colar os 3 campos acima

# === Vercel Blob (anexos) ===
BLOB_READ_WRITE_TOKEN=
# CHECKPOINT 5: Vercel Dashboard > Storage > Blob > .env pull ou copiar token

# === Resend (POC-08) ===
RESEND_API_KEY=
EMAIL_FROM=
INBOUND_WEBHOOK_SECRET=
# CHECKPOINT 6: Resend API Key + remetente verificado. Inbound exige dominio proprio com MX — ver plano Fase 4.

# === Gov.br (POC-02, predisposto) ===
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:3000/api/auth/govbr/callback
GOVBR_DISCOVERY_URL=
# CHECKPOINT 7: credenciamento Login Unico (homologacao). Enquanto vazio, rota usa MOCK (ver src/lib/govbr.ts).
