FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
BLOB_READ_WRITE_TOKEN=
DEFAULT_INTAKE_DEPARTMENT_ID=

# Etapa 9: ativar somente após provisionar executores/operador.
OPERATIONS_SERVICE_USER_ID=
OPERATIONS_SCHEDULER_SECRET=
OPERATIONS_TEMP_DIR=
